# Copy to ~/.config/partsapi/env (or ./.env), fill in, then: chmod 600 <file>
# Never commit the real file. Values already set in the environment win over this file.

# DigiKey: https://developer.digikey.com/  (enable "Product Information V4")
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# DIGIKEY_SANDBOX=1          # only for sandbox apps
# DK_CLIENT_ID / DK_CLIENT_SECRET / DK_SANDBOX also work

# Mouser: https://www.mouser.com/api-hub/
MOUSER_API_KEY=

# TME: https://developers.tme.eu/  (API v2: token = long value, secret = short value)
TME_TOKEN=
TME_SECRET=
# TME_COUNTRY=DE
# TME_CURRENCY=EUR
